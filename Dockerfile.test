FROM python:3.14-slim AS deps
WORKDIR /app
RUN pip install --only-binary :all: --upgrade pip setuptools wheel
RUN pip install --only-binary :all: \
    "pytest>=8.0" "pytest-cov>=5.0" "pytest-mock>=3.14" \
    "pydantic>=2.13.4" "pyyaml>=6.0" "typer>=0.27.1"

RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client \
    && rm -rf /var/lib/apt/lists/*
# Pin GitHub's published ed25519 host key instead of trusting whatever ssh-keyscan returns.
RUN mkdir -p -m 0700 /root/.ssh \
    && ssh-keyscan -t ed25519 github.com > /root/.ssh/known_hosts 2>/dev/null \
    && ssh-keygen -lf /root/.ssh/known_hosts | grep -q "SHA256:+DiY3wvvV6TuJJhbpZisF/zLDA0zPMSvHdkr4UvCOqU"
# Private dependency: fetched over the forwarded ssh agent, no key is stored in a layer.
RUN --mount=type=ssh pip install "chrysa-quality-gate @ git+ssh://git@github.com/chrysa/chrysa-lib.git@v0.3.0#subdirectory=packages/python/quality-gate"

FROM deps AS test
# Copy only necessary files to avoid inadvertently adding sensitive data
COPY scripts/ ./scripts/
COPY src/ ./src/
COPY templates/ ./templates/
COPY profiles/ ./profiles/
COPY tests/ ./tests/
# Run as non-root user
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser
ENV PYTHONPATH=/app/scripts:/app/src
CMD ["pytest", "tests/", "--cov=scripts", "--cov=src/project_init", "--cov-branch", \
     "--cov-report=xml:coverage.xml", "--cov-report=term-missing", \
     "--cov-fail-under=80", "-v"]
