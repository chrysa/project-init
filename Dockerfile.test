FROM python:3.14-slim AS deps
WORKDIR /app
RUN pip install --only-binary :all: --upgrade pip setuptools wheel
RUN pip install --only-binary :all: \
    "pytest>=8.0" "pytest-cov>=5.0" "pytest-mock>=3.14" \
    "pydantic>=2.13.4" "pyyaml>=6.0" "typer>=0.27.1"

FROM deps AS test
# Copy only necessary files to avoid inadvertently adding sensitive data
COPY scripts/ ./scripts/
COPY src/ ./src/
COPY templates/ ./templates/
COPY profiles/ ./profiles/
COPY tests/ ./tests/
# Run as non-root user
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser
ENV PYTHONPATH=/app/scripts:/app/src
CMD ["pytest", "tests/", "--cov=scripts", "--cov=src/project_init", "--cov-branch", \
     "--cov-report=xml:coverage.xml", "--cov-report=term-missing", \
     "--cov-fail-under=80", "-v"]
